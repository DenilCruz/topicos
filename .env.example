# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example) - SUPABASE & DJANGO
# ==============================================================================
# Copia este archivo a `.env` y reemplaza los valores de ejemplo con tus credenciales reales.

# ------------------------------------------------------------------------------
# OPCIÓN A: Cadena de Conexión Completa (DATABASE_URL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-[TU-REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# OPCIÓN B: Parámetros Individuales de Conexión
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=db.[TU-PROJECT-REF].supabase.co
DB_PORT=5432
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# SUPABASE API & SDK KEYS
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[TU-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=tu_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Variables para Frontend (React / Vite)
VITE_SUPABASE_URL=https://[TU-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_public_key

# ------------------------------------------------------------------------------
# DJANGO SETTINGS
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-segura
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# INTEGRACIONES
# ------------------------------------------------------------------------------
BONITA_API_URL=http://localhost:8080/bonita

